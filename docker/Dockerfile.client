# ---- Build stage ----
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Restore first (better layer caching) using only project files.
COPY src/Shared/Shared.csproj src/Shared/
COPY src/ChatClient/ChatClient.csproj src/ChatClient/
RUN dotnet restore src/ChatClient/ChatClient.csproj

# Copy the rest of the source and publish.
COPY src/ src/
RUN dotnet publish src/ChatClient/ChatClient.csproj -c Release -o /app --no-restore

# ---- Runtime stage ----
FROM mcr.microsoft.com/dotnet/runtime:8.0 AS runtime
WORKDIR /app
COPY --from=build /app ./

# Default configuration (overridable via docker-compose / environment).
ENV SERVER_HOST=server \
    SERVER_PORT=9000

ENTRYPOINT ["dotnet", "ChatClient.dll"]
